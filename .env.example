# Auth (required)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Admin login (Ishaq Technical Solution)
ADMIN_EMAIL=admin@ishaqtechnical.com
ADMIN_PASSWORD=change-me-strong-password
# Prefer a bcrypt hash in production:
# ADMIN_PASSWORD_HASH=$2a$12$...

# Optional site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional)
NODEMAILER_EMAIL=
NODEMAILER_PW=

# Firebase Firestore (recommended for production permanent ledger)
# Leave empty to use local .data/its-ledger.json on the server instead.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
